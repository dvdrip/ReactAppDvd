{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build-server",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/ReactAppDvd.Server/ReactAppDvd.Server.csproj"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "Build ReactAppDvd.Server",
			"type": "shell",
			"command": "dotnet build",
			"args": [
				"ReactAppDvd.Server/ReactAppDvd.Server.csproj"
			],
			"isBackground": false,
			"problemMatcher": [
				"$msCompile"
			]
		}
	]
}